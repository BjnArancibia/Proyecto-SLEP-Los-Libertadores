# ==============================================================================
# Variables de Entorno - SLEP Los Libertadores
# Plantilla de configuración para despliegue con Docker Compose
# Copiar este archivo a .env antes de iniciar el clúster: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Perimetral
# ------------------------------------------------------------------------------
# Puerto en el host donde escucha el proxy inverso unificado
GATEWAY_PORT=80

# ------------------------------------------------------------------------------
# 2. Backend Laravel
# ------------------------------------------------------------------------------
APP_NAME=SLEP-Inventario
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Clave de cifrado de la aplicación (generar con: php artisan key:generate --show)
APP_KEY=base64:c2xlcC1sb3MtbGliZXJ0YWRvcmVzLWFwcC1rZXkxMjM=

# Ejecutar automáticamente migraciones pendientes al iniciar el contenedor
AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# 3. Base de Datos Relacional (MySQL en Docker)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=slep_db
DB_USERNAME=slep_user
DB_PASSWORD=slep_secret_2026
MYSQL_ROOT_PASSWORD=slep_root_secret_2026

# ------------------------------------------------------------------------------
# 4. Asistente de IA con Ollama (Clasificación de Activos)
# ------------------------------------------------------------------------------
# Activar o desactivar el asistente de IA (true/false)
OLLAMA_ENABLED=true

# URL interna de la API HTTP de Ollama en la red Docker
OLLAMA_BASE_URL=http://ollama:11434

# Modelo instruct seleccionado (recomendado: qwen2.5:1.5b por balance memoria/calidad)
# Alternativas ligeras evaluadas: qwen2.5:0.5b (398MB), qwen2.5:3b (1.9GB), llama3.2:1b (1.3GB)
OLLAMA_MODEL=qwen2.5:1.5b

# Timeout en segundos para la inferencia del modelo
OLLAMA_TIMEOUT=60
OLLAMA_CONNECT_TIMEOUT=3

# Tiempo que Ollama mantiene el modelo en memoria RAM tras cada petición
OLLAMA_KEEP_ALIVE=10m

# ------------------------------------------------------------------------------
# 5. Monitoreo y Observabilidad (Portainer CE)
# ------------------------------------------------------------------------------
# Puerto web para el panel visual de métricas y gestión de contenedores
PORTAINER_PORT=9000
